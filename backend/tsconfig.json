{
  // Base config: type-checks BOTH src and test. Used by the editor and by
  // `npm run typecheck`. Emitting is done by tsconfig.build.json instead,
  // so that compiled test files never end up in dist/.
  "compilerOptions": {
    // File Layout
    "noEmit": true,

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node", "mocha"],

    // Other Outputs
    "sourceMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
