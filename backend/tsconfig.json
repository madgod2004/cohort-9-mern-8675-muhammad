{
  // typecheck only - build output comes from tsconfig.build.json
  "compilerOptions": {
    "noEmit": true,

    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node", "mocha"],

    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
